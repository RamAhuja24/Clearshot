# Copy to .env and adjust. Every value below has a sensible local default.

# --- Infrastructure (shared with docker-compose.yml) ---
POSTGRES_USER=clearshot
POSTGRES_PASSWORD=clearshot
POSTGRES_DB=clearshot
POSTGRES_PORT=5432
DATABASE_URL=postgres://clearshot:clearshot@localhost:5432/clearshot
TEST_DATABASE_URL=postgres://clearshot:clearshot@localhost:5432/clearshot_test

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally; console at http://localhost:9001).
# For real AWS S3, leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clearshot-images
S3_ACCESS_KEY_ID=clearshot
S3_SECRET_ACCESS_KEY=clearshot-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_PRESIGN_TTL_SECONDS=300
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- API ---
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
UPLOAD_MAX_BYTES=26214400
UPLOAD_RATE_LIMIT_PER_MINUTE=120
# Retries per image, stamped on each job when the API queues it (exponential backoff).
JOB_ATTEMPTS=3

# --- Worker ---
WORKER_CONCURRENCY=4

# --- Validation thresholds ---
VALIDATION_MIN_FILE_BYTES=20480
VALIDATION_MIN_DIMENSION_PX=512
VALIDATION_MAX_PIXELS=50000000
VALIDATION_BLUR_MIN_SCORE=100
VALIDATION_SIMILARITY_MAX_DISTANCE=8
VALIDATION_FACE_MIN_CONFIDENCE=0.7
VALIDATION_FACE_MIN_AREA_RATIO=0.03
VALIDATION_REJECT_NO_FACE=true
